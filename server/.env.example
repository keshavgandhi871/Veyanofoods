# Veyano Foods — Production Backend Environment Variables
# Copy this file to .env and fill in your real values

# ── Server ─────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Supabase Database ──────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Security & Authentication ──────────────────────
JWT_SECRET=veyano_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d
CLERK_SECRET_KEY=sk_test_placeholder

# ── Razorpay Payment Gateway ───────────────────────
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# ── Email Notifications (Resend API or SMTP) ───────
RESEND_API_KEY=re_placeholder_key
RESEND_FROM="VEYANO Orders <orders@veyano.in>"

# Fallback Nodemailer SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=veyanofoods@gmail.com
EMAIL_PASS=your_gmail_app_password

# ── Instant Admin Notifications ────────────────────
ADMIN_EMAIL=veyanofoods@gmail.com
FRONTEND_URL=https://veyano.in

# Instant Telegram Webhook / Bot
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_telegram_chat_or_channel_id
ADMIN_NOTIFICATION_WEBHOOK=https://your-custom-webhook.com/endpoint

# Instant WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_system_user_access_token
ADMIN_WHATSAPP_NUMBER=919350598909
ADMIN_WHATSAPP_WEBHOOK=

# ── Logistics (Shiprocket) ─────────────────────────
SHIPROCKET_EMAIL=your_shiprocket_email@example.com
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_API_URL=https://apiv2.shiprocket.in/v1/external

# ── AWS S3 Backups ──────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=veyano-db-backups
